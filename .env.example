# Synthetic fixtures by default. For public OpenAlex search: DATA_BACKEND=openalex
DATA_BACKEND=fixture
OPENALEX_API_KEY=

# Local mode: Ollama in Docker, no paid model API key.
LLM_PROVIDER=ollama
OLLAMA_MODEL=qwen3:4b
OLLAMA_BASE_URL=http://ollama:11434/v1

# Optional: only for switching to paid OpenAI API (LLM_PROVIDER=openai).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
